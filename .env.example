# Database
DATABASE_URL=postgresql://radio:radio_secret@localhost:5432/radiolive
POSTGRES_USER=radio
POSTGRES_PASSWORD=radio_secret
POSTGRES_DB=radiolive

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_SECRET=change-me-to-a-random-secret
JWT_SECRET=change-me-to-a-random-jwt-secret
CORS_ORIGIN=http://localhost:3000

# Streaming
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=changeme
ICECAST_ADMIN_PASSWORD=changeme
STREAM_MOUNT=/live

# Broadcaster
BROADCAST_KEY=change-me-broadcast-key

# App
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_STREAM_URL=http://localhost:8000/live
